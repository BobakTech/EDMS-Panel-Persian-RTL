# Base PHP API endpoint used by the front-end panel to load project information.
# Do not add changing query parameters here.
# Build dynamic parameters in the TypeScript service layer instead.
# Copy this file to .env.local and replace the value with your own local PHP panel URL.
# .env.local is ignored by Git and should contain only local configuration.
EXPO_PUBLIC_PROJECT_INFO_API_URL=REPLACE_WITH_YOUR_LOCAL_PROJECT_INFO_API_URL
